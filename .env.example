OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-5.6
OPENAI_MODEL_FAST=gpt-5.6-terra

# LLM speed knobs (backend)
# Narrate only the top-N findings by confidence (rest use templates). 0 = no LLM narrate.
LLM_NARRATE_MAX=8
# Parallel OpenAI narrate workers
LLM_NARRATE_WORKERS=4
# Extra per-finding fast-model quote trim (expensive; keep off unless needed)
LLM_TRIM_QUOTES=0
# One-shot policy/threshold extract before detectors
LLM_POLICY_EXTRACT=1
